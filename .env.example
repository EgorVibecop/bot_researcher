# Скопируй этот файл в .env и вставь свой токен от @BotFather
BOT_TOKEN=вставь_сюда_токен

# Необязательное
# ADMIN_ID=123456789            # твой Telegram id — для команды /admin
# CHECK_INTERVAL_MINUTES=30     # как часто проверять источники
# SEARCH_PERIOD_DAYS=7          # за какой период тянуть вакансии с hh
# DB_PATH=/data/jobs.db         # путь к базе на постоянном диске хостинга
# HH_TOKEN=                     # токен приложения hh.ru, если зарегистрируешь

# --- телеграм-каналы (необязательно) ---
# Публичные каналы читаются через веб-версию t.me/s/<канал>.
# Ни аккаунта, ни api_id, ни файла сессии не нужно.
# TG_CHANNELS=@ux_jobs,@researcher_jobs

# --- superjob (необязательно) ---
# Обычные страницы поиска отдают капчу, работаем только через их API.
# Ключ бесплатный: https://api.superjob.ru/register
# SUPERJOB_KEY=

# --- прочее ---
# HH_PAGES=3            # сколько страниц выдачи забирать с hh (по 50 на странице)
